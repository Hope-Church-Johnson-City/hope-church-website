# TinaCMS / TinaCloud credentials — copy to `.env` for local dev,
# and set the same values in Vercel → Project → Settings → Environment Variables.
# Get these from https://app.tina.io after creating your project.

# Public client id for your TinaCloud project (safe to expose in the browser).
NEXT_PUBLIC_TINA_CLIENT_ID=

# Read-only content token from TinaCloud (keep secret).
TINA_TOKEN=

# Optional: branch Tina edits. Defaults to the Vercel deploy branch, else "main".
# NEXT_PUBLIC_TINA_BRANCH=main
